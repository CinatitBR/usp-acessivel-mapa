{
  "name": "usp-acessibility-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm run worker:types --silent && tsc --noEmit -p worker",
    "test": "vitest run",
    "data:osm": "tsx scripts/fetch-osm.ts",
    "data:addresses": "tsx scripts/fetch-addresses.ts",
    "data:build": "tsx scripts/build-campus.ts",
    "data:transit": "tsx scripts/build-transit.ts",
    "check:data": "tsx scripts/check-data.ts",
    "worker:types": "wrangler types worker/worker-configuration.d.ts -c worker/wrangler.jsonc",
    "worker:dev": "wrangler dev -c worker/wrangler.jsonc",
    "deploy:worker": "wrangler deploy -c worker/wrangler.jsonc",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name usp-campus-map --branch main"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@vis.gl/react-maplibre": "8.1.3",
    "maplibre-gl": "6.12.0",
    "minisearch": "7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "earcut": "^3.2.4",
    "fflate": "0.8.3",
    "osmtogeojson": "3.0.0-beta.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "workbox-window": "7.4.1",
    "wrangler": "4.147.0"
  }
}
