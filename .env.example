# Copy to .env.local. These values are bundled into the client: never put secrets here.

# Base URL of the Cloudflare Worker (Olho Vivo and OpenRouteService proxy).
# Not needed for `npm run dev`: it reaches the local Worker through the /api proxy.
# Required for production builds, e.g. https://usp-campus-map-api.<account>.workers.dev
VITE_API_BASE=

# Sent as X-Client-Id to public services (Valhalla, Transitous) so operators can identify the app.
VITE_CLIENT_ID=usp-campus-map
