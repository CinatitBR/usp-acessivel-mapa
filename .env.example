# Copy to .env.local. These values are bundled into the client: never put secrets here.

# Base URL of the Cloudflare Worker (Olho Vivo and OpenRouteService proxy). Used from M4.
VITE_API_BASE=http://localhost:8787

# Sent as X-Client-Id to public services (Valhalla, Transitous) so operators can identify the app.
VITE_CLIENT_ID=usp-campus-map
