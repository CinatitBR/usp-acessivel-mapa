{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "usp-campus-map-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],

  // Set with `wrangler secret put <NAME>`; for local dev put them in worker/.dev.vars (gitignored).
  "secrets": { "required": ["OLHOVIVO_TOKEN"] },

  "vars": {
    // Comma-separated origins allowed to call this Worker from a browser.
    // Local dev and preview, plus the production site.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://usp-campus-map.pages.dev"
  },

  // Per-client limit on the Olho Vivo routes: 60 requests per minute.
  "ratelimits": [
    { "name": "OLHOVIVO_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
