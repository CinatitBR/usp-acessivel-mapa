{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "usp-campus-map-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],

  // Set with `wrangler secret put <NAME>`; for local dev put them in worker/.dev.vars (gitignored).
  "secrets": { "required": ["OLHOVIVO_TOKEN", "ORS_API_KEY"] },

  "vars": {
    // Comma-separated origins allowed to call this Worker from a browser.
    // Local dev and preview, plus the production site.
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173,https://usp-campus-map.pages.dev",
  },

  // Reports people make on the map. The id is not a secret. `wrangler dev` keeps a local copy,
  // set up with `npm run db:migrate:local`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "usp-campus-db",
      "database_id": "93eb075d-6a12-4a33-9245-5b609c9082dc",
      "migrations_dir": "migrations",
    },
  ],

  // Per-client limits: 60 requests per minute on the Olho Vivo routes and on reading reports, 10 on routing.
  "ratelimits": [
    {
      "name": "OLHOVIVO_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "ORS_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
    // Sending a report: 3 per minute per client.
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 3, "period": 60 },
    },
  ],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
