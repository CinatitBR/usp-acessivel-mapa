{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "usp-campus-map-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],

  // Set with `wrangler secret put <NAME>`; for local dev put them in worker/.dev.vars (gitignored).
  // REVIEW_TOKEN is the password reviewers type on the review page; choose a long random one.
  // GEMINI_API_KEY (https://aistudio.google.com/apikey) is optional: the chat needs it only when CHAT_PROVIDER is "gemini".
  "secrets": { "required": ["OLHOVIVO_TOKEN", "ORS_API_KEY", "REVIEW_TOKEN"] },

  "vars": {
    // Comma-separated origins allowed to call this Worker from a browser.
    // Local dev and preview on any port ("host:*"), plus the production site.
    "ALLOWED_ORIGINS": "http://localhost:*,http://127.0.0.1:*,https://usp-campus-map.pages.dev",
    // Who answers the campus chat: "workers-ai" (the AI binding below, free up to 10,000 neurons a day) or "gemini".
    "CHAT_PROVIDER": "workers-ai",
    // https://developers.cloudflare.com/workers-ai/models/ — about 30 neurons a question with the current sources.
    "WORKERS_AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    // https://ai.google.dev/gemini-api/docs/models
    "GEMINI_MODEL": "gemini-3.8-flash",
  },

  // Workers AI, for the campus chat. `wrangler dev` runs it on Cloudflare (it needs `wrangler login`) and it counts
  // towards the account's daily allowance.
  "ai": { "binding": "AI" },

  // Reports people make on the map. The id is not a secret. `wrangler dev` keeps a local copy,
  // set up with `npm run db:migrate:local`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "usp-campus-db",
      "database_id": "93eb075d-6a12-4a33-9245-5b609c9082dc",
      "migrations_dir": "migrations",
    },
  ],

  // Per-client limits: 300 requests per minute on the Olho Vivo routes and on reading reports (people on
  // the campus Wi-Fi can share one address, and one phone makes about 10), 10 on routing.
  "ratelimits": [
    {
      "name": "OLHOVIVO_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "ORS_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
    // Sending a report: 3 per minute per client.
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 3, "period": 60 },
    },
    // "Continua assim" and "Mudou" on a report: 10 per minute per client.
    {
      "name": "FEEDBACK_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 10, "period": 60 },
    },
    // A question to the campus chat: 6 per minute per client; each one is a paid model call.
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 6, "period": 60 },
    },
    // The review page: 30 per minute per client, which also keeps its password from being guessed.
    {
      "name": "REVIEW_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 30, "period": 60 },
    },
  ],

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
}
